@{
    ViewData["Title"] = "Home";
}
<!-- HERO SECTION -->
<div class="bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-5 fw-bold">Online Health Consultancy</h1>
                <p class="lead">
                    Talk to psychologists, dietitians, and doctors online.
                </p>
                <a asp-controller="Home" asp-action="Experts"
                   class="btn btn-light btn-lg">Find an Expert</a>
            </div>
        </div>
    </div>
</div>
<!-- CATEGORIES -->
<div class="container my-5">
    <h2 class="text-center mb-4">Which Expert Do You Need?</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card text-center h-100 border-0 shadow-sm">
                <div class="card-body py-4">
                    <h4>Psychologist</h4>
                    <p class="text-muted">
                        Expert support for anxiety, depression, and relationship issues.
                    </p>
                    <a asp-controller="Home" asp-action="Experts"
                       class="btn btn-outline-primary btn-sm">Find a Psychologist</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100 border-0 shadow-sm">
                <div class="card-body py-4">
                    <h4>Dietitian</h4>
                    <p class="text-muted">
                        A personal nutrition plan from an expert dietitian.
                    </p>
                    <a asp-controller="Home" asp-action="Experts"
                       class="btn btn-outline-primary btn-sm">Find a Dietitian</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center h-100 border-0 shadow-sm">
                <div class="card-body py-4">
                    <h4>Doctor</h4>
                    <p class="text-muted">Online consultation for general health issues.</p>
                    <a asp-controller="Home" asp-action="Experts"
                       class="btn btn-outline-primary btn-sm">Find a Doctor</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- STATISTICS -->
<div class="bg-light py-5">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-md-3">
                <h2 class="text-primary fw-bold">500+</h2>
                <p class="text-muted">Experts</p>
            </div>
            <div class="col-md-3">
                <h2 class="text-primary fw-bold">50,000+</h2>
                <p class="text-muted">Happy Clients</p>
            </div>
            <div class="col-md-3">
                <h2 class="text-primary fw-bold">100,000+</h2>
                <p class="text-muted">Completed Sessions</p>
            </div>
            <div class="col-md-3">
                <h2 class="text-primary fw-bold">4.8</h2>
                <p class="text-muted">Average Rating</p>
            </div>
        </div>
    </div>
</div>