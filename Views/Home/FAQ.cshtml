@{
    ViewData["Title"] = "FAQ";
}
<div class="container my-5">
    <h1 class="mb-4">Frequently Asked Questions</h1>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button" type="button"
                        data-bs-toggle="collapse" data-bs-target="#q1">
                    How does a session work?
                </button>
            </h2>
            <div id="q1" class="accordion-collapse collapse show">
                <div class="accordion-body">
                    Sessions take place via video call. After booking,
                    the link will be sent to your email.
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#q2">
                    Can I cancel my appointment?
                </button>
            </h2>
            <div id="q2" class="accordion-collapse collapse">
                <div class="accordion-body">
                    You can cancel for free up to 6 hours before the session.
                </div>
            </div>
        </div>
    </div>
</div>